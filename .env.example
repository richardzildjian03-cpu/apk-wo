# ============================================================
# Contoh konfigurasi environment untuk VPS.
# Salin file ini menjadi ".env" lalu sesuaikan nilainya.
#   cp .env.example .env
# ============================================================

# --- Database ---
# VPS memakai SQLite (file tersimpan permanen di server).
# Path relatif terhadap folder prisma/.
DATABASE_URL="file:./dev.db"

# --- Keamanan ---
# WAJIB diganti dengan kunci acak yang kuat. Buat dengan:
#   openssl rand -base64 48
AUTH_SECRET="ganti-dengan-kunci-acak-panjang-dan-unik"

# --- URL publik (SANGAT PENTING) ---
# Ini dipakai untuk membuat tautan undangan & isi QR code.
# Harus berupa domain/IP publik + protokol yang benar.
# Tanpa HTTPS, kamera HP akan diblokir browser.
#
# Contoh domain + SSL : APP_URL="https://wo.domainanda.com"
# Contoh IP tanpa SSL : APP_URL="http://203.0.113.10:3000"
APP_URL="https://wo.domainanda.com"

# --- Opsional ---
# Port aplikasi (default Next.js: 3000). Ubah bila bentrok.
# PORT="3000"
